# Copy to server/.env on the app server and fill in. Never commit the real .env.
PORT=8203
# MongoDB on the private DB instance (database: c2stem-class)
MONGO_URI=mongodb://c2stem:CHANGE_ME@10.0.0.5:27017/c2stem-class?authSource=admin
MONGO_POOL_SIZE=20
# Must stay the same as today, or every existing login token becomes invalid
JWT_SECRET_KEY=CHANGE_ME
# Origins allowed to call the API with credentials (comma-separated)
CORS_ORIGINS=https://spice.c2-stem.org
JSON_LIMIT=5mb
